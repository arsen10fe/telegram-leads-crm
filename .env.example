# Copy to .env and fill in. Never commit .env.
# NODE_ENV is set by Next.js and the npm scripts — do not put it here.

# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the CRM. Session cookies get the `secure` flag only for https URLs.
# `npm run dev` listens on 3100.
APP_URL=http://localhost:3100
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug
# Signs session cookies. At least 32 characters: `openssl rand -base64 48`
AUTH_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# compose.yml (Docker) publishes Postgres on 127.0.0.1:5433.
# A local Homebrew Postgres usually listens on 127.0.0.1:5432.
DATABASE_URL=postgresql://lidogram:lidogram@127.0.0.1:5433/lidogram
# Integration tests (*.int.test.ts) run only when this is set. Never point it at real data:
# the tests truncate every table.
TEST_DATABASE_URL=postgresql://lidogram:lidogram@127.0.0.1:5433/lidogram_test

# ── Telegram ──────────────────────────────────────────────────────────────────
# Local development uses a separate DEV bot: only one process may poll a token.
# Enable Secretary Mode for it in @BotFather to test Telegram Business locally.
TELEGRAM_BOT_TOKEN=
# Bot username without @, used in links and hints.
TELEGRAM_BOT_USERNAME=

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
# Kill switch. With false, leads and tags work exactly the same, AI features are skipped.
AI_ENABLED=false
# Required when AI_ENABLED=true.
OPENAI_API_KEY=
# Fast model for qualification and tags, smarter model for replies.
# Check what your key can use with `npx tsx scripts/ai-smoke.ts`.
OPENAI_MODEL_FAST=gpt-5.4-nano
OPENAI_MODEL_SMART=gpt-5.4-mini
# Optional HTTP(S) proxy for OpenAI calls (e.g. when the host is geo-blocked).
OPENAI_PROXY_URL=

# ── Demo data (prisma/seed.ts) ────────────────────────────────────────────────
SEED_MANAGER_EMAIL=manager@demo.local
SEED_MANAGER_PASSWORD=
# Show the demo login and password on the login page (for reviewers).
SHOW_DEMO_CREDENTIALS=false

# ── Production (compose.prod.yml) ─────────────────────────────────────────────
# On the server, start from this file and change:
#   APP_URL=https://<your-domain>   LOG_LEVEL=info   AI_ENABLED=true   SHOW_DEMO_CREDENTIALS=true
#   TELEGRAM_BOT_TOKEN / TELEGRAM_BOT_USERNAME of the PRODUCTION bot (not the dev one)
#   a fresh AUTH_SECRET and SEED_MANAGER_PASSWORD
# DATABASE_URL is built by compose from the three values below (it points at the `postgres`
# service), so the line above is ignored in production. Letters and digits only in the password:
# `openssl rand -hex 24`
POSTGRES_USER=lidogram
POSTGRES_PASSWORD=
POSTGRES_DB=lidogram
# Hostname for Caddy (`--profile edge`): crm.example.com or <name>.<ip-with-dashes>.sslip.io
APP_DOMAIN=
# Host port of the web container (bound to 127.0.0.1) when the host's own nginx proxies to it
APP_HTTP_PORT=3000
# Containers run in UTC otherwise; the app itself always uses Europe/Moscow for dates
TZ=Europe/Moscow
